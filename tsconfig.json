{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // Import alias, same shape as the Next project's `@/*` — but pointed at
    // `src/` rather than the repo root, since Astro keeps all source there.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
