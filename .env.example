# Copy this file to `.env` and fill in the values.
# `.env` is gitignored; this template is committed as documentation.
#
# Astro exposes variables prefixed with PUBLIC_ to client-side code and inlines
# them at build time — the same role Next's NEXT_PUBLIC_ prefix played.
# https://docs.astro.build/en/guides/environment-variables/

# Web3Forms access key — get yours free at https://web3forms.com
# Public-by-design (safe in client code); routes contact-form submissions to your email.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Résumé link shown in the social rail. If unset, the link is omitted.
PUBLIC_RESUME_URL=

# Canonical origin for SEO / Open Graph URLs. Optional: on Vercel this falls
# back to the project's production domain, and locally to http://localhost:4321.
PUBLIC_SITE_URL=
