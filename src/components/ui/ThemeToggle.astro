---
// A theme toggle styled like a boolean config flag:  darkMode ●━○ true
//
// Flipping the theme is just toggling the .dark class on <html> (global.css
// keys every color token off it) and remembering the choice in localStorage.
// The matching inline script in Layout.astro reapplies that choice before paint
// on every load, so there's no flash of the wrong theme.
//
// In the Next version this was a React client component that deliberately held
// *no* React state — the knob position, track color, and true/false label are
// all pure CSS (Tailwind `dark:` variants driven by the .dark class). With no
// state and no reconciliation to do, there's nothing for React to earn here, so
// in Astro it becomes a plain .astro component with one <script>. Zero React,
// zero hydration, and the "no hydration mismatch" concern disappears entirely.
---

{/* Positioning is Nav.astro's job — this used to be `fixed right-4 top-4 z-50`
    back when there was no nav bar for it to live in. Now it's a plain inline
    button and the bar places it, which is why it can be reused anywhere.
    The frosted surface bg keeps it legible over whatever scrolls behind, and
    h-11 meets the 44px touch-target minimum. */}
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle light and dark theme"
  class="inline-flex h-11 items-center gap-2 rounded-md border border-foreground/15 bg-surface/80 px-3 font-mono text-xs text-muted shadow-sm backdrop-blur transition-colors hover:border-foreground/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  <span class="text-foreground">darkMode</span>

  {/* Switch track + sliding knob — pure CSS via the dark: variant. The knob
      slides right and the track turns accent in dark mode. The CSS net in
      global.css strips these transitions under prefers-reduced-motion, so the
      knob just jumps. aria-hidden: it's decorative, the label names it. */}
  <span
    aria-hidden="true"
    class="relative inline-flex h-4 w-8 items-center rounded-full bg-foreground/20 px-0.5 transition-colors dark:bg-accent"
  >
    <span
      class="h-3 w-3 rounded-full bg-background shadow transition-transform duration-200 dark:translate-x-4"
    ></span>
  </span>

  {/* The flag's value. Both are in the DOM; CSS shows the one matching the
      theme (the hidden one is display:none, so it's inert). */}
  <span aria-hidden="true" class="text-muted dark:hidden">false</span>
  <span aria-hidden="true" class="hidden text-accent dark:inline">true</span>
</button>

<script>
  // A bundled module script: deferred, so the button is already in the DOM.
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  button?.addEventListener('click', () => {
    // classList.toggle returns true when the class ends up present (= dark).
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
