---
// The site nav. It only exists because the site stopped being one page: from a
// post there is no scroll that gets you to #work, so there has to be a bar.
//
// Two floating controls rather than a full-width bar with a background: the
// theme toggle already established that language (a frosted pill in the corner),
// and a solid bar would put a horizontal line across the top of the hero, which
// is the one part of the page that should feel open.
//
// Static: the only JavaScript on this bar is the theme toggle's own <script>.
import ThemeToggle from "@/components/ui/ThemeToggle.astro";

// `Astro.url` is the URL of the page currently being generated — available in
// frontmatter because that runs at build time, once per page. That's what lets
// the mobile link below differ per page with no client-side route matching and
// no JS: each HTML file is built with its own answer baked in.
//
// Trailing slashes are normalized because whether a built path ends in one
// depends on the `trailingSlash` config, and this comparison shouldn't care.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
// The three "writing" sections. Being inside one of these means the mobile link
// should offer a way back OUT, rather than a way in.
const SECTION_ROOTS = ["/blog", "/snippets", "/monthlog"];
const sectionRoot = SECTION_ROOTS.find(
  (root) => pathname === root || pathname.startsWith(`${root}/`),
);

// Anchors MUST be absolute. A bare `#work` from /blog/hello-world resolves
// against the current page and scrolls nowhere — the section isn't there.
const links = [
  { href: "/#work", label: "/#work" },
  { href: "/#writing", label: "/#writing" },
  { href: "/#contact", label: "/#contact" },
];

// At 375px the toggle is ~150px wide, which leaves no room for three 44px touch
// targets. So mobile gets exactly one link, and which one depends on where you
// are — the single most useful move from here.
//
// One level deep (a post, a snippet, a month) the label names the ACTUAL
// destination — `← /snippets`, not `← /writing`. With one section that
// distinction didn't exist; with three, a link labelled "writing" that lands on
// /snippets is just wrong.
const mobileLink = !sectionRoot
  ? { href: "/#writing", label: "/writing →" }
  : pathname === sectionRoot
    ? { href: "/", label: "← /home" }
    : { href: sectionRoot, label: `← ${sectionRoot}` };

const LINK_BASE =
  "h-11 items-center rounded-md px-3 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
---

{
  /* <header> + <nav> are the landmarks a screen reader navigates by. z-50 keeps
    it above the sticky avatar lane. `inset-x-0` + justify-between pins the pill
    left and the toggle right without either knowing the other's width. */
}
<header
  class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-3 px-4 py-4"
>
  <nav
    aria-label="Main"
    class="flex items-center rounded-md border border-foreground/15 bg-surface/80 px-1 font-mono text-xs shadow-sm backdrop-blur"
  >
    {
      /* Mobile only. `sm:hidden` — mobile-first: the base state is visible, the
        breakpoint takes it away. */
    }
    <a
      href={mobileLink.href}
      data-avatar-react
      class:list={[
        "inline-flex sm:hidden",
        LINK_BASE,
        "text-muted hover:text-foreground",
      ]}
    >
      {mobileLink.label}
    </a>

    {
      /* sm: and up — the full set. No aria-current anywhere in here: all three
        are in-page anchors pointing at sections of `/`, and aria-current="page"
        is only truthful for a link pointing at the page you're actually on.
        Marking an anchor as the current page would be a lie to a screen
        reader. */
    }
    {
      links.map((link) => (
        <a
          href={link.href}
          data-avatar-react
          class:list={[
            "hidden sm:inline-flex",
            LINK_BASE,
            "text-muted hover:text-foreground",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  {
    /* The toggle used to position itself `fixed right-4 top-4`. It now lives
      here, so the bar owns placement and the button is just a button. */
  }
  <ThemeToggle />
</header>
