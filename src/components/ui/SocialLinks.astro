---
// A set of links to public profiles (GitHub, LinkedIn, Resume).
//
// A plain .astro component: these are static anchors with no browser events of
// their own, so they ship no JS. The sticky avatar's hover hook queries
// [data-avatar-react] from the DOM at mount (see Avatar.tsx), and these links
// are in that DOM before any island hydrates — so they trigger the avatar
// reaction without any extra wiring.
//
// The value matters: data-avatar-react="rail" (not just the bare attribute)
// tells the avatar to give these links a distinct "look over" reaction.
//
// The Resume URL comes from PUBLIC_RESUME_URL so it can be updated in the host
// (and .env) without code changes; if it's unset the link is simply omitted.
// (Astro inlines PUBLIC_* vars at build time, so changing it takes effect on
// the next deploy — same semantics as Next's NEXT_PUBLIC_ prefix.)
interface Props {
  // Lets the parent add layout classes (e.g. spacing) without this component
  // having to know about its surroundings.
  class?: string;
}

const { class: className = '' } = Astro.props;

// Set PUBLIC_RESUME_URL in .env locally and in your host's project settings.
// When it's missing we omit the link rather than render a dead one.
const resumeUrl = import.meta.env.PUBLIC_RESUME_URL;

// Shared anchor styling. 44x44px (h-11 w-11) meets the touch-target minimum;
// fill="currentColor" on the icon lets these text utilities drive its color.
const linkClass =
  'inline-flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors hover:bg-foreground/5 hover:text-foreground';
---

{/* A list, semantically — it's a set of related links. aria-label names the
    group for screen readers. Mobile-first: a horizontal row by default (a
    thumb-friendly strip under the avatar), switching to a vertical rail beside
    the avatar from md up. Any parent classes are folded in. */}
<ul aria-label="Social links" class:list={['flex flex-row items-center gap-1 md:flex-col', className]}>
  {/* ---------- GitHub ---------- */}
  <li>
    <a
      href="https://github.com/krazykaushal"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      data-avatar-react="rail"
      class={linkClass}
    >
      {/* Official GitHub mark. aria-hidden because the <a> above is already
          named via aria-label, so the icon shouldn't be announced too. */}
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>
  </li>

  {/* ---------- LinkedIn ---------- */}
  <li>
    <a
      href="https://www.linkedin.com/in/kaushalpatel29"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      data-avatar-react="rail"
      class={linkClass}
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
        ></path>
      </svg>
    </a>
  </li>

  {/* ---------- Resume (URL from PUBLIC_RESUME_URL) ---------- */}
  {
    resumeUrl && (
      <li>
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Resume"
          data-avatar-react="rail"
          class={linkClass}
        >
          {/* Document icon (Material "description"). */}
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path
              d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
            />
          </svg>
        </a>
      </li>
    )
  }
</ul>
