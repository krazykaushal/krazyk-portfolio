---
// One month, as a calendar tile. Used by /monthlog's year groups.
//
// Unlike PostCard, the WHOLE card is the link. PostCard couldn't do that because
// its tag pills are links too and a link inside a link is invalid HTML — there's
// nothing else interactive in here, so the whole tile can be the anchor. That's
// both better UX (the entire target is clickable) and a free 44px touch target.
import type { MonthlogEntry } from '@/lib/monthlog';

interface Props {
  entry: MonthlogEntry;
  /** Heading level for the month name. /monthlog nests these under a year <h2>. */
  headingLevel?: 3 | 4;
  class?: string;
}

const { entry, headingLevel = 3, class: className = '' } = Astro.props;
const { month, title } = entry.data;

// A capitalized variable holding a tag name renders as that element. The ternary
// (rather than a template string) keeps the type a literal union so TypeScript
// still checks it as a real HTML tag.
const Heading = headingLevel === 3 ? 'h3' : 'h4';

// `month` is `YYYY-MM`, guaranteed by the schema regex — so slicing is exact.
const monthNumber = month.slice(5);

// Just the month name; the year is the group heading above, so repeating it here
// would be noise. UTC + a pinned locale for the usual build-time reason.
const monthName = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  timeZone: 'UTC',
}).format(new Date(`${month}-01T00:00:00Z`));
---

<li class:list={['group', className]}>
  {/* `group` on the <li> + `group-*:` below coordinates the hover across the
      whole tile — the accent rail, the arrow and the border all respond to
      hovering anywhere on the card, not just the element under the pointer.

      `h-full` makes every tile match the tallest in its grid row, so a long
      title doesn't leave a short neighbour floating. */}
  <a
    href={`/monthlog/${month}`}
    class="relative flex h-full flex-col overflow-hidden rounded-xl border border-foreground/10 bg-surface p-6 transition-colors hover:border-accent/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
  >
    {/* Accent rail down the left edge. Scales from the top on hover — scaleY is
        a transform, so it's composited and cheap, unlike animating height.
        aria-hidden: pure decoration. */}
    <span
      aria-hidden="true"
      class="absolute inset-y-0 left-0 w-0.5 origin-top scale-y-0 bg-accent transition-transform duration-300 group-hover:scale-y-100"
    ></span>

    {/* The date line, styled like a tear-off calendar tile: the month number in
        mono, muted, with the accent picking it up on hover. */}
    <p
      class="font-mono text-xs tabular-nums text-muted transition-colors group-hover:text-accent"
    >
      <time datetime={month}>{monthNumber}</time>
    </p>

    <Heading
      class="mt-3 text-2xl font-bold tracking-tight text-foreground transition-colors group-hover:text-accent"
    >
      {monthName}
    </Heading>

    {/* line-clamp-2 keeps tiles a predictable height whatever the title length.
        It's core Tailwind in v4 — no plugin. */}
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{title}</p>

    {/* mt-auto pins this to the tile bottom so the affordance lines up across a
        row. The arrow slides on hover; global.css strips the transition under
        prefers-reduced-motion, so it simply appears in place. */}
    <p class="mt-auto pt-6 font-mono text-xs text-accent">
      Read
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </p>
  </a>
</li>
