---
// One snippet, as a card. Same three-prop shape as PostCard for the same
// reasons: it renders a single <li> and lets each caller own the <ul> and its
// grid, so /snippets and the language browse pages can lay it out differently.
//
// Fully static — no state, no browser events, so it ships zero JavaScript.
import type { Snippet } from '@/lib/snippets';
import { formatDate } from '@/lib/content';

interface Props {
  snippet: Snippet;
  /**
   * Headings shouldn't skip levels, and this card appears under two different
   * ancestors: under a page <h1> on /snippets, and under a section <h2> if the
   * home-page hub ever teases snippets. The caller is the only one that knows.
   */
  headingLevel?: 2 | 3;
  class?: string;
}

const { snippet, headingLevel = 2, class: className = '' } = Astro.props;

// Astro renders a capitalized variable holding a tag name as that element. The
// ternary (rather than a template string) keeps the type a literal union, so
// TypeScript still checks it as a real HTML tag instead of widening to string.
const Heading = headingLevel === 2 ? 'h2' : 'h3';

const { title, description, language, tags, addedDate } = snippet.data;

// `id` is the slug the glob loader derived from the filename.
const href = `/snippets/${snippet.id}`;
---

{/* data-avatar-react is the site's single definition of "interactive" — the
    avatar queries it, so adding the attribute is all the wiring needed. */}
<li
  data-avatar-react
  class:list={[
    'flex flex-col rounded-xl border border-foreground/10 bg-surface p-6 transition-colors hover:border-accent/40',
    className,
  ]}
>
  <Heading class="text-lg font-semibold">
    {/* The title is the link, not the whole card. The card can't be an <a>
        because it would then be the only interactive thing here — and if tags
        ever become links, a link inside a link is invalid HTML.

        `-m-2 p-2` is the touch-target trick: padding grows the hit area to
        ~44px, the equal negative margin pulls the box back so nothing shifts
        visually. `inline-block` is needed for the padding to apply. */}
    <a
      href={href}
      class="-m-2 inline-block rounded-md p-2 text-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      {title}
    </a>
  </Heading>

  {/* The language badge gets the accent treatment and the tags below stay
      muted — deliberately different, because one is a required taxonomy with a
      browse page behind it and the others are free-form labels. Making them
      look alike would imply they behave alike. */}
  <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-xs">
    <span class="rounded bg-accent/10 px-1.5 py-0.5 font-medium text-accent">
      {language}
    </span>
    <span class="text-muted" aria-hidden="true">·</span>
    {/* <time datetime> ships the machine-readable date beside the human one. */}
    <time class="text-muted" datetime={addedDate.toISOString()}>
      {formatDate(addedDate)}
    </time>
  </p>

  {description && (
    <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
  )}

  {/* Tags are plain <li> labels, NOT links. /snippets/tags/<tag> doesn't exist
      (see "out of scope" in WRITING.md), and linking to a route that isn't
      there is just a broken link. Because they aren't anchors they also need no
      touch-target treatment — nothing to tap. */}
  {
    tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label="Tags">
        {tags.map((tag) => (
          <li class="rounded-full bg-foreground/5 px-2.5 py-1 text-xs font-medium text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</li>
