---
// Snippets for one language. Structurally this is /blog/tags/[tag].astro again —
// second rep of the same pattern.
//
// It lives at /snippets/languages/<language>, NOT /snippets/<language>, and that
// nesting is load-bearing. The detail page is /snippets/<slug>, also one dynamic
// segment under /snippets — so a snippet whose slug happened to be `python`
// would resolve to the same URL as the `python` browse page. That's a
// duplicate-path build error you'd only discover the day you named a file that
// way. Nesting the browse axis removes the possibility, and mirrors
// /blog/tags/<tag>.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/ui/Footer.astro';
import SnippetCard from '@/components/snippets/SnippetCard.astro';
import {
  allLanguages,
  getPublishedSnippets,
  snippetsByLanguage,
} from '@/lib/snippets';

// One page per language actually in use. Note this maps over allLanguages(),
// which is derived from the snippets — not from the z.enum. A language you've
// declared but never written generates no page, which is what you want: no
// empty browse pages.
//
// Because the URLs are derived from the data, a language page with zero snippets
// is unreachable by construction. There's no empty state to write.
export const getStaticPaths = (async () => {
  const snippets = await getPublishedSnippets();

  return allLanguages(snippets).map((language) => ({
    params: { language },
    props: { language, snippets: snippetsByLanguage(snippets, language) },
  }));
}) satisfies GetStaticPaths;

// `satisfies GetStaticPaths` above + this alias are how a dynamic page gets
// typed props: InferGetStaticPropsType reads the function's return type, and
// Astro types Astro.props from a local type named `Props`.
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { language, snippets } = Astro.props;

const count = `${snippets.length} ${snippets.length === 1 ? 'snippet' : 'snippets'}`;
---

<Layout
  title={`${language} snippets — Kaushal Patel`}
  description={`Code snippets written in ${language}.`}
>
  <main class="mx-auto w-full max-w-4xl px-6 pb-16 pt-24 sm:pb-24 sm:pt-28">
    <a
      href="/snippets"
      data-avatar-react
      class="font-mono text-sm text-muted transition-colors hover:text-foreground"
    >
      ← All snippets
    </a>

    <h1
      class="mt-8 font-mono text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
    >
      {language}
    </h1>

    <p class="mt-3 font-mono text-xs text-muted">{count}</p>

    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {snippets.map((snippet) => <SnippetCard snippet={snippet} headingLevel={2} />)}
    </ul>
  </main>

  <Footer />
</Layout>
