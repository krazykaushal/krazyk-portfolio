---
// The calendar. A card per month that exists, grouped by year — no empty cells
// for months without an entry, so the grid looks right from the first entry
// rather than after a year of them.
//
// The month's content lives on its own page now (see [month].astro). This page
// is navigation only, which is why it renders no MDX at all.
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/ui/Footer.astro';
import MonthCard from '@/components/monthlog/MonthCard.astro';
import { getPublishedMonths, groupByYear } from '@/lib/monthlog';

const entries = await getPublishedMonths();

// Already sorted newest-first, so the year groups come out descending too — see
// the comment on groupByYear for why that falls out of Map ordering.
const years = groupByYear(entries);
---

<Layout
  title="Monthlog — Kaushal Patel"
  description="What I'm working on and thinking about, one entry a month."
>
  <main class="mx-auto w-full max-w-4xl px-6 pb-16 pt-24 sm:pb-24 sm:pt-28">
    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      Monthlog
    </h1>

    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
      What I'm building, breaking and thinking about — one entry a month.
    </p>

    {
      entries.length === 0 ? (
        <p class="mt-10 font-mono text-sm text-muted">Nothing logged yet.</p>
      ) : (
        <div class="mt-16 flex flex-col gap-16">
          {years.map(({ year, entries: yearEntries }) => (
            <section aria-labelledby={`year-${year}`}>
              {/* The year is a real heading — it's a section of the archive, and
                  it's what a screen-reader user would navigate by. Month names
                  inside the cards are h3s underneath it. */}
              <h2
                id={`year-${year}`}
                class="font-mono text-sm tabular-nums text-muted"
              >
                {year}
              </h2>

              {/* A hairline under the year to make the grouping read as a
                  calendar band rather than just spacing. */}
              <div aria-hidden="true" class="mt-3 h-px bg-foreground/10"></div>

              {/* Three across on desktop keeps tiles squarish; two at sm so a
                  tablet isn't one long column. The grid lives here, not in
                  MonthCard — the card renders one <li> and lets the caller
                  choose columns. */}
              <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {yearEntries.map((entry) => (
                  <MonthCard entry={entry} headingLevel={3} />
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </main>

  <Footer />
</Layout>
