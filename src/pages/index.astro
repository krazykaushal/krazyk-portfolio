---
// The app/page.tsx replacement. Astro routes by file, so this file *is* `/`.
//
// The interesting difference from Next: every child below is either a plain
// .astro component (zero JS) or a React island with an explicit `client:*`
// directive saying when to hydrate. In Next the split was 'use client' inside
// each component; here it's a decision made at the call site, per usage.
import Layout from '@/layouts/Layout.astro';

import Hero from '@/components/sections/Hero.tsx';
import About from '@/components/sections/About.tsx';
import Work from '@/components/sections/Work.astro';
import Writing from '@/components/sections/Writing.astro';
import Skills from '@/components/sections/Skills.astro';
import Contact from '@/components/sections/Contact.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Avatar from '@/components/Avatar/Avatar.tsx';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import HeroBackground from '@/components/ui/HeroBackground.astro';
import Footer from '@/components/ui/Footer.astro';
---

<Layout>
  {/* Subtle drifting grid behind the hero, fading out before About.
      Rendered outside <main> (which is max-w-7xl) so it spans the full
      viewport width. Absolute + -z-30 keeps it behind both the content and
      the sticky avatar lane (whose halos sit at -z-20). */}
  <HeroBackground />

  {/* mobile: single column, avatar stacked on top.
      md+: two columns (flex-row-reverse puts the avatar lane on the right). */}
  <main class="mx-auto flex max-w-7xl flex-col md:flex-row-reverse md:items-start">
    {/* Avatar lane. On md+ it's `sticky top-0 h-svh`, so it stays centered
        in the viewport while the content column scrolls past, releasing near
        the bottom. On mobile it's just a block at the top. */}
    <div
      class="flex flex-col items-center justify-center gap-6 px-6 pt-20 md:sticky md:top-0 md:h-svh md:w-2/5 md:shrink-0 md:flex-row md:gap-4 md:px-0 md:pt-0 lg:w-1/3"
    >
      <div class="relative w-56 shrink-0 sm:w-72 md:min-w-0 md:flex-1">
        {/* accent halo */}
        <div
          aria-hidden="true"
          class="absolute left-1/2 top-[-10%] -z-20 aspect-square w-[88%] -translate-x-1/2 rounded-full bg-accent/20 blur-2xl"
        >
        </div>
        {/* Light circle behind the head so the dark hair reads — only needed
            in dark mode; on a light page the dark figure reads on its own, so
            we hide it there (hidden dark:block) to avoid a gray smudge. */}
        <div
          aria-hidden="true"
          class="absolute left-1/2 top-[-6%] -z-10 hidden aspect-square w-[78%] -translate-x-1/2 rounded-full bg-linear-to-b from-zinc-100 to-zinc-300 dark:block"
        >
        </div>
        {/* client:load — the avatar is the centerpiece and plays an intro on
            first paint, so it hydrates as soon as possible. */}
        <Avatar client:load className="h-auto w-full" />
      </div>

      {/* Social links. Mobile: a horizontal row centered under the avatar
          (no cursor to drive the hover reaction, so a thumb-friendly row
          beats a vertical rail). md+: a vertical rail on the avatar's right
          (SocialLinks switches direction itself). Each link carries
          data-avatar-react="rail", so the avatar turns to "look over" at it
          on hover (see Avatar.tsx). It renders to static HTML, so the links
          are in the DOM before the avatar island hydrates. */}
      <SocialLinks class="shrink-0" />
    </div>

    {/* Content lane. min-w-0 lets it shrink properly beside the avatar lane. */}
    <div class="md:min-w-0 md:flex-1">
      {/* client:load — the hero runs its text intro on load, above the fold. */}
      <Hero client:load />
      <Reveal>
        {/* The terminal only starts typing once it's on screen, so there's no
            reason to hydrate it earlier — but its outputs are server-rendered
            at opacity-0 (real content for crawlers, revealed as each command
            "runs"). The rootMargin hydrates it just before it scrolls in, so
            you never catch the terminal on screen and still blank. */}
        <About client:visible={{ rootMargin: '200px' }} />
      </Reveal>
      <Reveal>
        <Work />
      </Reveal>
      {/* After Work, before Skills: projects, then writing about them, reads in
          the right order. Scroll position is a content decision, not a
          technical one. */}
      <Reveal>
        <Writing />
      </Reveal>
      <Reveal>
        <Skills />
      </Reveal>
      <Reveal>
        <Contact />
      </Reveal>
    </div>
  </main>

  {/* Site footer — outside <main> so it's full-width and its own landmark. */}
  <Footer />
</Layout>
