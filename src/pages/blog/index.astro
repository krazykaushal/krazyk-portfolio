---
// The post index. `src/pages/blog/index.astro` maps to `/blog` — a folder with
// an index file, exactly like `src/pages/index.astro` maps to `/`.
//
// Everything here runs at build time: the frontmatter reads the collection, the
// markup renders to static HTML. The only JavaScript this page ships is the
// Reveal script — the sticky avatar lane used to live here and no longer does,
// so the Avatar island is gone from this route entirely.
import Layout from '@/layouts/Layout.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Footer from '@/components/ui/Footer.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPublishedPosts } from '@/lib/blog';

const posts = await getPublishedPosts();
---

<Layout
  title="Writing — Kaushal Patel"
  description="Notes on building for the web — Astro, React, animation, and whatever I'm learning."
>
  {/* A centered column, the same shell as /snippets and the tag pages: this is
      a list you come here to read, so the measure matters more than the
      showcase. That also settles the open question those files left — the
      two-lane sticky-avatar shell now has exactly one copy (the home page), so
      there's nothing left to extract into a PageShell.astro. */}
  <main class="mx-auto w-full max-w-4xl px-6 pb-16 pt-24 sm:pb-24 sm:pt-28">
    {/* <h1> because this is the page's own title — the home page's sections
        use <h2> since the hero owns the h1 there. One h1 per page. */}
    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      Blog
    </h1>

    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
      Notes on things I'm building and learning — mostly the web platform,
      animation, and whatever I've just gotten wrong.
    </p>

    {
      posts.length === 0 ? (
        /* An empty list renders as a bare heading with nothing under it,
           which reads as broken rather than as "no posts yet". */
        <p class="mt-8 font-mono text-sm text-muted">
          Nothing published yet. Soon.
        </p>
      ) : (
        <Reveal>
          {/* The layout lives here, not in PostCard — the card renders one
              <li> and lets each caller arrange them. A single flex column
              rather than a grid: every row is full width, so there are no
              columns to declare and no equal-height problem to solve.

              `layout="row"` is opt-in, so the tag pages and the home-page
              teaser keep their grid of tiles untouched. */}
          <ul class="mt-10 flex flex-col gap-4">
            {posts.map((post) => (
              <PostCard post={post} headingLevel={2} layout="row" />
            ))}
          </ul>
        </Reveal>
      )
    }
  </main>

  <Footer />
</Layout>
